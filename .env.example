# Copy to an ignored local .env or export explicitly. Never commit credentials.
# The server reads environment variables; it does not automatically load .env.
WOLD_DATABASE_URL=postgresql://localhost/hammer_world
WOLD_DB_SCHEMA=public
# local mode leaves player APIs open for loopback development; use private behind TLS.
WOLD_ACCESS_MODE=local
# Required in private mode. Read-only player access is limited to explicit campaign IDs.
WOLD_PLAYER_TOKEN=
WOLD_PLAYER_CAMPAIGNS=demo,demo-v2,campaign
# Set a long random token yourself. Admin access is denied when unset.
WOLD_GM_TOKEN=
# Server-side token and distinct real/demo destinations; leave blank to keep outbox pending.
WOLD_DRIVE_ACCESS_TOKEN=
WOLD_DRIVE_FOLDER_ID=
WOLD_DRIVE_DEMO_FOLDER_ID=
